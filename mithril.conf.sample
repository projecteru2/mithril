# mithril sample configuration; every key can be overridden on the command
# line as --<key> <value>.

bind 0.0.0.0
port 7979

# address clients should be told to connect to (cluster emulation)
# announce-addr 127.0.0.1:7979

# seed nodes of the backing Redis Cluster
bootstrap 127.0.0.1:7001,127.0.0.1:7002,127.0.0.1:7003

# worker threads; defaults to the number of CPU cores
# worker-threads 4

# sticky shared connections per node per worker
backend-conns 1
# one process-wide pipe per node (deeper backend batches for unpipelined load):
# no | yes | auto (per session: unpipelined sessions share, pipelining ones stay local)
# backend-sharding auto

# worker-local GET/MGET reply cache, kept coherent by server-side key tracking
# reply-cache no
# reply-cache-max-bytes 64mb
# reply-cache-max-age-secs 10

# client auth (empty = no auth) and backend auth
# requirepass secret
# ACL users in Redis ACL SETUSER syntax (repeatable), the channels a new user starts with, the ACL LOG size
# user app on >secret ~app:* &* -@all +@read +@string
# acl-pubsub-default allchannels
# acllog-max-len 128
# slowlog-log-slower-than -1
# slowlog-max-len 128
# backend-auth-user default
# backend-auth-pass secret

# replica read splitting: off | master_readwrite | master_writeonly
slave-mode off

# new-connection placement across workers: least-loaded | round-robin
placement least-loaded

maxclients 10000
tcp-keepalive 300
query-buffer-limit 1gb
topology-refresh-secs 15
loglevel notice
